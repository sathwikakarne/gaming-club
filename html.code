<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pixel Arena | Gaming Club</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <!-- Header / Navigation -->
    <header>
        <div class="logo">Pixel<span>Arena</span></div>
        <nav>
            <ul>
                <li><a href="index.html">Home</a></li>
                <li><a href="#about">About</a></li>
                <li><a href="#tournaments">Tournaments</a></li>
                <li><a href="#contact">Contact</a></li>
            </ul>
        </nav>
    </header>

    <!-- Hero Section -->
    <section class="hero">
        <h1>Level Up Your Game</h1>
        <p>Join the ultimate local gaming community, compete in tournaments, and connect with elite players.</p>
        <a href="#tournaments" class="btn">View Tournaments</a>
    </section>

    <!-- About Section -->
    <section id="about" class="about">
        <h2>Who We Are</h2>
        <p>We are a community-driven gaming club providing high-end rigs, regular esports events, and a place to hang out with fellow gamers.</p>
    </section>

    <!-- Footer -->
    <footer id="contact">
        <p>&copy; 2026 Pixel Arena Gaming Club. All rights reserved.</p>
    </footer>

    <script src="app.js"></script>
</body>
</html>
